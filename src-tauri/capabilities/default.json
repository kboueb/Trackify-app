{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtres de l'application (principale, sélecteur rapide, rappel)",
  "windows": [
    "main",
    "palette",
    "reminder"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "dialog:allow-save",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
